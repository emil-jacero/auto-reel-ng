        "summary": "Get Event",
        "description": "``GET /api/v1/events/{event_id}`` (task 2.3): current detail from disk.",
        "operationId": "get_event_api_v1_events__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
