# Copy to .env (optional; these are the defaults compose.yaml uses without it). Dev values, no secrets.
# The GUI's host port, bound to 127.0.0.1 only.
AR_PORT=8132
# The auto-reel-media fixture, mounted read-only and never written.
AR_MEDIA_DIR=../auto-reel-media
# Where the scratch library, movies, caches and render scratch live (library/, library-output/,
# cache/, tmp/). Keep any other value outside the repository (or add it to .dockerignore).
AR_DATA_DIR=./data
# The stack's Postgres password; applied only to a fresh pgdata volume (change it with `down -v`).
# It goes into DATABASE_URL unescaped, so use URL-safe characters only: letters, digits, - _ .
AR_DB_PASSWORD=auto_reel_ng
# The local image's tag (localhost/auto-reel-ng:<tag>). A second checkout's stack sets its own,
# together with `-p <name>`, so the two stacks never rebuild each other's image.
AR_IMAGE_TAG=compose
